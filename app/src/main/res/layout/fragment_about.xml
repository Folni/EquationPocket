<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="EquationPocket"
            android:textColor="@color/teal_700"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Vaš digitalni repozitorij jednadžbi"
            android:textColor="#757575"
            android:textSize="16sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:text="EquationPocket je napredna Android aplikacija dizajnirana za studente, profesore i stručnjake u STEM područjima (fizika, kemija, matematika). \n\nAplikacija omogućuje:\n\n• Organizaciju jednadžbi u prilagođene mape (Pockets).\n• Napredno rješavanje formula pomoću Symja CAS engine-a.\n• Podršku za derivacije, integrale, limese i sume.\n• Dinamičko prepoznavanje varijabli i automatski izračun nepoznanica.\n• Specijaliziranu znanstvenu tastaturu za brz unos simbola."
                    android:textSize="16sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Izradio: Filip"
            android:textColor="#757575"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>