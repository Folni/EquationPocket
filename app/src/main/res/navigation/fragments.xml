<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/menuPockets"
    android:id="@+id/fragments">

    <fragment
        android:id="@+id/menuPockets"
        android:label="@string/pockets"
        android:name="hr.algebra.equationpocket.fragment.PocketsFragment"
        tools:layout="@layout/fragment_pockets">
        <action
            android:id="@+id/action_pockets_to_equations"
            app:destination="@id/equationsFragment" />
    </fragment>

    <fragment
        android:id="@+id/menuAbout"
        android:label="@string/about"
        android:name="hr.algebra.equationpocket.fragment.AboutFragment"
        tools:layout="@layout/fragment_about"/>

    <fragment
        android:id="@+id/menuHelp"
        android:label="@string/help"
        android:name="hr.algebra.equationpocket.fragment.HelpFragment"
        tools:layout="@layout/fragment_help"/>

    <fragment
        android:id="@+id/menuTutorial"
        android:label="@string/tutorial"
        android:name="hr.algebra.equationpocket.fragment.TutorialFragment"
        tools:layout="@layout/fragment_tutorial_trigger"/>

    <fragment
        android:id="@+id/equationsFragment"
        android:name="hr.algebra.equationpocket.fragment.EquationsFragment"
        android:label="{pocketName}">
        <argument
            android:name="pocketId"
            app:argType="long" />
        <argument
            android:name="pocketName"
            app:argType="string" />
        <action
            android:id="@+id/action_equations_to_solver"
            app:destination="@id/solverFragment" />
        <action
            android:id="@+id/action_equations_to_camera"
            app:destination="@id/cameraFragment" />
    </fragment>

    <fragment
        android:id="@+id/cameraFragment"
        android:name="hr.algebra.equationpocket.fragment.CameraFragment"
        android:label="Skeniranje" />

    <fragment
        android:id="@+id/solverFragment"
        android:name="hr.algebra.equationpocket.fragment.SolverFragment"
        android:label="Solver">
        <argument
            android:name="formula"
            app:argType="string" />
        <action
            android:id="@+id/action_solver_to_history"
            app:destination="@id/historyFragment" />
    </fragment>

    <fragment
        android:id="@+id/historyFragment"
        android:name="hr.algebra.equationpocket.fragment.HistoryFragment"
        android:label="Povijest">
        <action
            android:id="@+id/action_history_to_graph"
            app:destination="@id/graphFragment" />
    </fragment>

    <fragment
        android:id="@+id/graphFragment"
        android:name="hr.algebra.equationpocket.fragment.GraphFragment"
        android:label="Graf">
        <argument
            android:name="history"
            app:argType="hr.algebra.equationpocket.model.HistoryEntry[]" />
        <argument
            android:name="xAxisVar"
            app:argType="string" />
        <argument
            android:name="useLogScale"
            app:argType="boolean"
            android:defaultValue="false" />
    </fragment>

</navigation>